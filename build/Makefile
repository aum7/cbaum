	$(MAKE) $(MAKESILENT) -f CMakeFiles/cbaumplugin.dir/build.make CMakeFiles/cbaumplugin.dir/cbaumplugin_cbaumPlugin.cpp.i
.PHONY : cbaumplugin_cbaumPlugin.cpp.i

cbaumplugin_cbaumPlugin.s: cbaumplugin_cbaumPlugin.cpp.s
.PHONY : cbaumplugin_cbaumPlugin.s

# target to generate assembly for a file
cbaumplugin_cbaumPlugin.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/cbaumplugin.dir/build.make CMakeFiles/cbaumplugin.dir/cbaumplugin_cbaumPlugin.cpp.s
.PHONY : cbaumplugin_cbaumPlugin.cpp.s

